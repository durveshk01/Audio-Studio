PORT=10000
NODE_ENV=development
MAX_UPLOAD_FILES=20
MAX_FILE_MB=100
MAX_REQUEST_MB=200
MAX_CONCURRENT_JOBS=2
MAX_QUEUED_JOBS=4
FFMPEG_THREADS=2
JOB_TTL_MINUTES=60
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
TEMP_ROOT=
ENABLE_METATUNE=false
METATUNE_PORT=10001
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional web backend; Android uses bundled device-only processing.
VITE_BACKEND_URL=
# JSON map of owner IDs to distinct tokens (32-256 characters), supplied privately.
API_TOKENS=
# Configure a persistent directory to enable library metadata-index sync.
SYNC_STORAGE_DIR=
POLLINATIONS_API_KEY=
