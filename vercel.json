{
  "buildCommand": "npm run build:client",
  "outputDirectory": "dist/client",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/(home|compressor|metatune|tools|library|settings)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
