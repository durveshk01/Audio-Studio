{
  "name": "audiocompress",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite --host 0.0.0.0\" \"tsx watch src/server/index.ts\"",
    "build": "tsc --noEmit && vite build && tsup src/server/index.ts --format esm --platform node --target node20 --out-dir dist/server --clean",
    "build:client": "tsc --noEmit && vite build",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run build && cap sync android && cd android && gradlew.bat assembleDebug",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "verify:audio": "tsx scripts/verify-audio-processing.ts",
    "verify:ffmpeg": "tsx scripts/verify-ffmpeg.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "archiver": "^7.0.1",
    "browser-id3-writer": "^6.4.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.468.0",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^5.0.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^1.7.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/archiver": "^6.0.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.1.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "readdir-glob": {
      "minimatch": "^11.0.1"
    }
  }
}
